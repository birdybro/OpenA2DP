/*
 * OpenA2DP GUI binary VERSIONINFO resource.
 *
 * Compiled by rc.exe at build time, linked into OpenA2DP.exe.
 * Right-click → Properties → Details in Explorer reads this block,
 * and so do tools that scrape FILEVERSION (gh release upload, etc).
 *
 * When bumping the version, update both the FILEVERSION/PRODUCTVERSION
 * comma-separated tuples AND the corresponding string-form values.
 * Also bump version_cli.rc to match, and add a CHANGELOG entry.
 */

#include <winver.h>
#include "oa2dp_resource.h"

/* Embedded application icon.  rc.exe is invoked from the project
 * root, so the path is relative to that. */
IDI_APP_ICON ICON "icon.ico"

#define OA2DP_VER_MAJOR 0
#define OA2DP_VER_MINOR 5
#define OA2DP_VER_PATCH 0
#define OA2DP_VER_BUILD 0

#define OA2DP_VER_STRING "0.5.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    OA2DP_VER_MAJOR,OA2DP_VER_MINOR,OA2DP_VER_PATCH,OA2DP_VER_BUILD
 PRODUCTVERSION OA2DP_VER_MAJOR,OA2DP_VER_MINOR,OA2DP_VER_PATCH,OA2DP_VER_BUILD
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OpenA2DP contributors"
            VALUE "FileDescription",  "OpenA2DP - Bluetooth A2DP control"
            VALUE "FileVersion",      OA2DP_VER_STRING
            VALUE "InternalName",     "OpenA2DP"
            VALUE "LegalCopyright",   "Licensed under GPL-3.0-only"
            VALUE "OriginalFilename", "OpenA2DP.exe"
            VALUE "ProductName",      "OpenA2DP"
            VALUE "ProductVersion",   OA2DP_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
