/*
 * OpenA2DP CLI binary VERSIONINFO resource.
 * Same metadata as version_gui.rc except for OriginalFilename and
 * FileDescription.  Keep the version numbers in sync.
 */

#include <winver.h>

#define OA2DP_VER_MAJOR 0
#define OA2DP_VER_MINOR 4
#define OA2DP_VER_PATCH 0
#define OA2DP_VER_BUILD 0

#define OA2DP_VER_STRING "0.4.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    OA2DP_VER_MAJOR,OA2DP_VER_MINOR,OA2DP_VER_PATCH,OA2DP_VER_BUILD
 PRODUCTVERSION OA2DP_VER_MAJOR,OA2DP_VER_MINOR,OA2DP_VER_PATCH,OA2DP_VER_BUILD
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OpenA2DP contributors"
            VALUE "FileDescription",  "OpenA2DP CLI - Bluetooth A2DP control"
            VALUE "FileVersion",      OA2DP_VER_STRING
            VALUE "InternalName",     "OpenA2DP-cli"
            VALUE "LegalCopyright",   "Licensed under GPL-3.0-only"
            VALUE "OriginalFilename", "OpenA2DP-cli.exe"
            VALUE "ProductName",      "OpenA2DP"
            VALUE "ProductVersion",   OA2DP_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
